{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAuroraSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:230802932766:secret:wardwatch/aurora-master-*"
    },
    {
      "Sid": "CallBedrockModels",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-2-multimodal-embeddings-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*::foundation-model/deepseek.r1-v1:0",
        "arn:aws:bedrock:us-east-1:230802932766:inference-profile/us.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:us-east-1:230802932766:inference-profile/us.deepseek.r1-v1:0"
      ]
    }
  ]
}
