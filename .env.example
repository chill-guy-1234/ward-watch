# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Local database (docker compose reads these automatically) ---
POSTGRES_USER=wardwatch
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wardwatch
POSTGRES_PORT=5432

# Full URL used by the Python pipeline. Host is `localhost` from your machine,
# `db` from inside the Docker network.
WARDWATCH_DB_URL=postgresql://wardwatch:change_me@localhost:5432/wardwatch

# --- AWS ---
AWS_REGION=us-east-1

# Bootstrap credential: authenticates every Bedrock call. This one CANNOT live
# in AWS Secrets Manager — reading Secrets Manager requires AWS credentials, so
# something must hold this outside the vault. Keep it here (gitignored), or in
# your OS credential store / environment.
AWS_BEARER_TOKEN_BEDROCK=

# --- Models (override the defaults in code if desired) ---
# WARDWATCH_CHAT_MODEL=us.deepseek.r1-v1:0
# WARDWATCH_CONDENSE_MODEL=us.amazon.nova-2-lite-v1:0
